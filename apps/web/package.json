{
  "name": "@dshhub/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsx ../../scripts/build-static.mts",
    "build:cloudflare": "pnpm build",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm build && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "dev": "pnpm build && wrangler dev --port 3000",
    "preview": "wrangler dev --port 3000",
    "typecheck": "tsc --noEmit",
    "upload": "pnpm build && wrangler versions upload"
  },
  "dependencies": {
    "@dshhub/contracts": "workspace:*",
    "@orpc/client": "1.15.0",
    "@orpc/contract": "1.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
